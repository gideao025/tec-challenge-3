              "graphql": {
                "query": "query HistoricoDoPaciente($pacienteId: ID, $apenasFuturas: Boolean) {\n  consultasPorPaciente(pacienteId: $pacienteId, apenasFuturas: $apenasFuturas) {\n    id\n    dataHora\n    status\n    observacoes\n    paciente { id nome email }\n    medico { id nome especialidade }\n  }\n}",
