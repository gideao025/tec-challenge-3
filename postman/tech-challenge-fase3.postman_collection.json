                  "const body = pm.response.json();",
                  "pm.test('sem erros GraphQL', () => pm.expect(body.errors, JSON.stringify(body.errors)).to.be.undefined);",
                  "pm.test('retornou consultas', () => pm.expect(body.data.consultasPorPaciente).to.be.an('array').that.is.not.empty);"
