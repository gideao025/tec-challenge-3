    {
      "name": "3. Acesso negado",
      "description": "Casos de autorizacao. Os erros de ROLE e de OWNERSHIP chegam como `classification: FORBIDDEN` dentro do array `errors` (HTTP 200, como manda o GraphQL); a falta de token e barrada antes, com HTTP 401.",
      "item": [
        {
          "name": "PACIENTE nao pode criar consulta (FORBIDDEN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 (GraphQL sinaliza a falha no array errors)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('acesso negado com classification FORBIDDEN', () => {",
                  "    pm.expect(body.errors, 'esperava um erro de autorizacao').to.be.an('array');",
                  "    pm.expect(body.errors[0].extensions.classification).to.eql('FORBIDDEN');",
                  "});",
                  "pm.test('nenhum dado vazou', () => pm.expect(body.data && body.data.criarConsulta).to.not.be.ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CriarConsulta($input: CriarConsultaInput!) {\n  criarConsulta(input: $input) {\n    id\n    dataHora\n    status\n    observacoes\n    paciente { id nome }\n    medico { id nome }\n  }\n}",
