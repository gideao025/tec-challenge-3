      "item": [
        {
          "name": "Login - MEDICO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devolve token Bearer', () => {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tipo).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('tokenMedico', body.token);",
                  "console.log('tokenMedico salvo:', body.role);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"medico@hospital.com\",\n  \"senha\": \"senha123\"\n}"
